# ===== ENV.md is canonical. This file mirrors it. SECRET = server-only, never NEXT_PUBLIC_. =====
# --- Phase 1 (all optional; the build succeeds with this file empty) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PRODUCT_NAME=Girder
NEXT_PUBLIC_ANALYTICS_KEY=
# --- Phase 2: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — bypasses RLS. Only lib/supabase/admin.ts may read it.
SUPABASE_SERVICE_ROLE_KEY=
# --- Phase 3: AI vision ---
ANTHROPIC_API_KEY=
AI_VISION_MODEL=
AI_MAX_OUTPUT_TOKENS=
AI_DAILY_SPEND_CEILING_CENTS=
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_MAX_ANALYSES_PER_IP=
# --- Phase 5: Email ---
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# --- Phase 5.5: Payments + legal entity ---
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDATION_SETUP=
STRIPE_PRICE_FOUNDATION_MONTHLY=
STRIPE_PRICE_OPERATOR_SETUP=
STRIPE_PRICE_OPERATOR_MONTHLY=
LEGAL_SELLER_NAME=
LEGAL_SELLER_COUNTRY=
LEGAL_SELLER_SUPPORT_EMAIL=
ADMIN_NOTIFY_PHONE=
SMS_PROVIDER_KEY=
# --- Phase 6 ---
ADMIN_ALLOWED_EMAIL=
# --- Phase 10 (optional providers) ---
# OpenRouter is the primary provider for vision analysis AND for the finish
# render. Without it lib/ai/images.ts returns 'not_configured' and the tool
# card renders its upload block visibly inert instead of shipping a button
# that always fails.
OPENROUTER_API_KEY=
# Comma-separated model slugs for the finish render, tried in order.
# Unset uses the default chain in lib/ai/images.ts, which has never been
# benchmarked — see the VERIFY note in that file.
AI_IMAGE_MODELS=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
AI_GENERIC_API_KEY=
AI_GENERIC_BASE_URL=
# --- Phase 11.5 ---
WEATHER_API_KEY=
# --- Phase 16 ---
# Nothing new is required. The theme (0018_site_settings) and tool media
# (0019_tool_media) are stored in the database and changed from /admin, not
# from here — that was the point of putting them in a table.
#
# ADMIN_NOTIFY_EMAIL (Phase 5, above) now also receives implementation
# requests from /start and the homepage form. If it is unset those rows are
# still saved, but nothing tells you they arrived.
